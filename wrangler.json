{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamdo-tablet",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamdo-exhibition",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "HOURLY_ANALYSIS_LIMIT": "50",
    "ACCOUNT_DAILY_ANALYSIS_LIMIT": "300",
    "DAILY_ANALYSIS_LIMIT": "300",
    "SESSION_HOURS": "12"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
